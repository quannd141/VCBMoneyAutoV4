{
  "Logging": { "LogLevel": { "Default": "Information" } },
  "AllowedHosts": "*",
  "Kestrel": { "Endpoints": { "Http": { "Url": "http://0.0.0.0:5000" } } },
  "VcbMoney": {
    "VcbMoneyDb": {
      "Server": "localhost",
      "DatabaseName": "VCB_MONEY",
      "UseWindowsAuth": true,
      "TrustServerCertificate": true
    },
    "TrungGianDb": {
      "Server": "localhost",
      "DatabaseName": "DBTRUNGGIAN",
      "UseWindowsAuth": true,
      "TrustServerCertificate": true
    },
    "Files": {
      "FolderInput": "D:\\VCBMoney\\Input",
      "FolderProcessing": "D:\\VCBMoney\\Output\\Processing",
      "FolderArchive": "D:\\VCBMoney\\Output\\Success",
      "FolderError": "D:\\VCBMoney\\Output\\Error",
      "AllowedExtensions": [ ".txt" ]
    },
    "Jobs": {
      "Job1_ScanFiles": { "Enabled": true, "CronExpression": "*/1 * * * *", "BatchSize": 1000 },
      "Job2_ScanPayOrder": { "Enabled": true, "CronExpression": "*/1 * * * *", "BatchSize": 2000 },
      "Job3_ParseFiles": { "Enabled": true, "CronExpression": "*/1 * * * *", "BatchSize": 1000 },
      "Job4_TransformPayOrder": { "Enabled": true, "CronExpression": "*/1 * * * *", "BatchSize": 1000 },
      "Job5_SyncResult": { "Enabled": true, "CronExpression": "*/5 * * * *", "BatchSize": 1000 },   
      "Job6_Cleanup": { "Enabled": true, "CronExpression": "0 8 * * *", "BatchSize": 1 }
    },
    "Business": {
      "CustomerCode": "VCB001",
      "FileRetentionDays": 90,
      "MaxRetryCount": 3,
      "RetryDelayMinutes": 30,
      "AmountLimitNoApproval": 500000000
    }
  }
}
